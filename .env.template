# ── Wallet ────────────────────────────────────────────────────────────────
POLY_PRIVATE_KEY=0x...
SIGNATURE_TYPE=0          # 0=EOA  1=POLY_PROXY (Magic Link)  2=GNOSIS_SAFE (MetaMask)
FUNDER_ADDRESS=           # Required only if SIGNATURE_TYPE=1 or 2

# ── Network ───────────────────────────────────────────────────────────────
RPC_URL=https://polygon-rpc.com   # Use Alchemy/Ankr for reliability

# ── Trading ───────────────────────────────────────────────────────────────
BANKROLL_USDC=500
PAPER=true                # Never set false until paper validation checklist passes
MAX_TRADE_SIZE_USDC=50

# ── Polymarket API (optional — re-derived each session if absent) ──────────
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Telegram remote control (optional) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Data feeds (optional — adds signal detail) ────────────────────────────
FRED_API_KEY=
GLASSNODE_API_KEY=

# ════════════════════════════════════════════════════════════════════════════
# MAKER BOT TUNING  (all optional — defaults shown)
# ════════════════════════════════════════════════════════════════════════════

# ── Inventory / Risk ─────────────────────────────────────────────────────────
MAKER_MAX_INVENTORY_PER_MARKET=20   # shares cap per market (non-weather categories)
MAKER_MAX_TOTAL_INVENTORY=700       # portfolio-wide share cap across all markets
MAKER_MAX_DAILY_LOSS_PCT=0.03       # stop all quoting if MTM loss exceeds this % of bankroll

# Per-category share caps (0 = use MAKER_MAX_INVENTORY_PER_MARKET as fallback)
MAKER_WEATHER_INV_CAP=5             # tight — same-day NegRisk resolution risk
MAKER_SPORTS_INV_CAP=0
MAKER_POLITICS_INV_CAP=0
MAKER_CRYPTO_INV_CAP=0
MAKER_FINANCE_INV_CAP=0
MAKER_ENTERTAINMENT_INV_CAP=0

# ── Quote sizing ─────────────────────────────────────────────────────────────
MAKER_QUOTE_SIZE=10                 # base shares per ladder level (before regime scaling)
MAKER_LADDER_LEVELS=3               # number of bid/ask pairs per market
MAKER_LEVEL_STEP=0.01               # price offset between ladder levels

# ── Spread ───────────────────────────────────────────────────────────────────
MAKER_BASE_SPREAD=0.06              # starting spread before all adjustments
MAKER_MIN_SPREAD=0.02               # hard floor — never quote tighter than this
MAKER_MAX_SPREAD=0.15               # hard ceiling

# ── Market selection ─────────────────────────────────────────────────────────
MAKER_MAX_ACTIVE_MARKETS=30         # max markets quoted simultaneously
MAKER_MIN_DAILY_VOLUME=1000         # skip markets with < this USD 24h volume
MAKER_MIN_BID=0.10                  # skip markets where bid < this (near-zero/resolved)
MAKER_MAX_BID=0.90                  # skip markets where bid > this (near-certain)
MAKER_MAX_DAYS_TO_RESOLVE=7         # skip markets resolving more than N days out
MAKER_MIN_DAYS_TO_RESOLVE=0.17      # skip markets resolving in less than ~4h
MAKER_MIN_DAYS_TO_RESOLVE_WEATHER=0.33  # weather-specific minimum: ~8h
MAKER_EXCLUDED_CATEGORIES=          # comma-separated to pause, e.g. weather,sports

# ── Circuit breakers ─────────────────────────────────────────────────────────
MAKER_COOLDOWN_SECONDS=300          # quote pause after inventory cap hit (escalates on repeats)
MAKER_ADVERSE_COOLDOWN_SECONDS=1800 # extended pause for adverse selection / weather cap
MAKER_RAPID_FILL_WINDOW=5.0         # both sides filled within this seconds → pull quotes
MAKER_ADVERSE_MIN_FILLS=5           # min fills before one-directional stream check fires
MAKER_ADVERSE_DIRECTION_PCT=0.80    # fraction same-side to trigger adverse detection
MAKER_PRE_RES_HOURS=2.0             # promote to reduce-only within this hours of expiry

# ── Category spread multipliers (applied on top of base spread) ───────────────
# Higher = wider spreads for that category. Tune after 500+ fills per category.
MAKER_SPREAD_MULT_FINANCE=1.0
MAKER_SPREAD_MULT_CRYPTO=1.2
MAKER_SPREAD_MULT_POLITICS=1.3
MAKER_SPREAD_MULT_SPORTS=1.6
MAKER_SPREAD_MULT_WEATHER=2.0
MAKER_SPREAD_MULT_ENTERTAINMENT=2.2
MAKER_SPREAD_MULT_DEFAULT=1.5       # fallback for uncategorised markets

# ── VPIN / NegRisk ───────────────────────────────────────────────────────────
MAKER_VPIN_STALE_SECONDS=180        # reset VPIN to neutral after this silence period
MAKER_NEGRISK_SIBLING_THRESHOLD=0.80  # weather sibling mid above this → cancel losers
